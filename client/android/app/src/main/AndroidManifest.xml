<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required at runtime, not just for development - this app talks to a
         backend server over HTTP(S) for every real operation. Previously only
         declared in the debug/profile manifest overlays (added there for the
         Flutter tool's own hot-reload/DevTools connection), which is why
         `flutter run` (debug mode) always worked but a genuine release build
         never had network access at all - a real, pre-existing gap surfaced
         by the first real release-build on-device test. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- AI Modelling workstream 11 (voice input, `docs/ai-modelling/11-
         voice-input.md`): required for `speech_to_text`'s on-device
         recognition. The runtime grant prompt itself is triggered by the
         plugin's own `initialize()` call, not by this declaration alone -
         no separate `permission_handler` dependency needed (confirmed
         during that workstream's own spike). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Server Management screen (see client/lib/server_management/): lets
         this app dispatch RUN_COMMAND intents to Termux's RunCommandService
         to control an on-device standalone backend (pull/start/stop) - see
         https://github.com/termux/termux-app/wiki/RUN_COMMAND-Intent. This
         is a "dangerous"-level permission Termux itself defines, so it also
         needs a runtime grant (MainActivity.kt's requestPermission), not
         just this manifest declaration. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND"/>
    <application
        android:label="didsa_cad_client"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- flutter_scene (the Stage 7 3D viewport) needs the Flutter GPU
                 embedding feature - without it, `Scene()`'s GpuContext throws
                 at construction and the viewport spins forever, since that
                 throw happens inside an unawaited Future with no error UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.EnableFlutterGPU"
              android:value="true"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Receives the async result Termux sends back via the
             PendingIntent passed as com.termux.RUN_COMMAND_PENDING_INTENT
             (MainActivity.kt's buildResultPendingIntent) - not exported,
             only Termux (holding the PendingIntent itself) can invoke it. -->
        <service
            android:name=".TermuxResultService"
            android:exported="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <meta-data
            android:name="io.flutter.embedding.android.EnableFlutterGPU"
            android:value="true" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Package visibility (Android 11+/targetSdkVersion 30+): without
             this, the RUN_COMMAND intent to Termux silently fails to
             resolve - see server_management_screen.dart. -->
        <package android:name="com.termux"/>
        <!-- AI Modelling workstream 11 (voice input): same package-
             visibility requirement as above, for `speech_to_text`'s own
             on-device recognition service lookup - without this, Android
             11+/targetSdkVersion 30+ silently fails to find any speech
             recognizer even when one is genuinely installed. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
